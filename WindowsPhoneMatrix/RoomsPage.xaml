<Page
    x:Class="WindowsPhoneMatrix.RoomsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WindowsPhoneMatrix"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    RequestedTheme="Dark">
    <Grid Background="#1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="20,20,20,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Content="&#xE72B;" FontFamily="Segoe MDL2 Assets" Background="Transparent" Foreground="White" FontSize="20" Click="BackButton_Click" Margin="0,0,15,0"/>

            <TextBlock Grid.Column="1" x:Name="WelcomeText" Text="Loading chats..." FontSize="24" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" TextWrapping="Wrap"/>

            <Button Grid.Column="2" Content="&#xE149;" FontFamily="Segoe MDL2 Assets" Background="Transparent" Foreground="White" FontSize="20" Click="RefreshButton_Click" Margin="15,0,0,0"/>
        </Grid>

        <ListView Grid.Row="1" x:Name="RoomsListView" IsItemClickEnabled="True" ItemClick="RoomsListView_ItemClick" Margin="20,0,20,0">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,10,0,10">
                        <TextBlock Text="{Binding RoomName}" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock Text="{Binding RoomId}" FontSize="12" Foreground="Gray" Margin="0,5,0,0"/>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
